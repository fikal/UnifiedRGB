<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UnifiedRgb.Core\UnifiedRgb.Core.csproj" />
    <!-- The App as well, so LightingController and the scene/design
         normalizers get real regressions instead of being untestable.
         It is a WPF exe, hence UseWPF below; nothing in the harness
         constructs a window or the view model. -->
    <ProjectReference Include="..\UnifiedRgb.App\UnifiedRgb.App.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- `dotnet test` on a plain console project reports success having run
       nothing. Run the harness from the VSTest target so a CI or a habit that
       reaches for `dotnet test` still gets the real pass/fail (Exec fails the
       build on a non-zero exit code = the failure count). -->
  <Target Name="RunHarnessOnDotnetTest" AfterTargets="VSTest">
    <Exec Command="dotnet &quot;$(TargetPath)&quot;" />
  </Target>

</Project>
