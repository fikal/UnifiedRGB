<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UnifiedRgb.Core\UnifiedRgb.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UnifiedRGB-Diagnostic</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Intel SMBus module (signed, namazso PawnIO.Modules) so the diag can
         identify Intel chipset SMBus too; AMD PIIX4 comes from Core. -->
    <EmbeddedResource Include="Modules\SmbusI801.bin" />
  </ItemGroup>

</Project>
