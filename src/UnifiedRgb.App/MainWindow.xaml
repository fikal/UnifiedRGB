<Window x:Class="UnifiedRgb.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnifiedRgb.App"
        xmlns:controls="clr-namespace:UnifiedRgb.App.Controls"
        xmlns:views="clr-namespace:UnifiedRgb.App.Views"
        Title="UnifiedRgb" Height="700" Width="1240" Icon="Assets/app.ico"
        Background="#FF16171B" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <!-- 1px glass strip keeps the DWM shadow without extending glass over
             the whole window (full-glass + our per-frame preview = drag judder). -->
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="8"
                      GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Title bar ===================== -->
        <Grid Grid.Row="0" Background="#FF101116">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="12" Height="12" CornerRadius="6">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFF0060" Offset="0"/>
                            <GradientStop Color="#FF8A2BFF" Offset="0.5"/>
                            <GradientStop Color="#FF00A0FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock Text="UnifiedRGB" FontWeight="SemiBold" FontSize="13"
                           Foreground="#FFD8DAE2" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="#FF6A6E7A"
                           Margin="7,1,0,0" VerticalAlignment="Center"/>
                <!-- The badge is its own progress bar: it fills as the download
                     runs and says each step (preparing, downloading N% of MB,
                     verifying, restarting). It used to keep its label through
                     the release lookup and show only a small percentage after,
                     which read as a stalled click. While an install runs it
                     takes no clicks; it does not grey out, it is working. -->
                <Button FontSize="11" Padding="0" Margin="14,0,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding InstallUpdateCommand}"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Accent}">
                            <Setter Property="ToolTip" Value="Download the new build and restart"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UpdateBusy}" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <!-- A hard edge in a full-width gradient, not a scaled
                             shape: scaling a rounded rect squashed its corners
                             and they poked out past the badge's own. -->
                        <Border CornerRadius="7">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#47FFFFFF" Offset="0"/>
                                    <GradientStop Color="#47FFFFFF" Offset="{Binding UpdateProgressScale}"/>
                                    <GradientStop Color="#00FFFFFF" Offset="{Binding UpdateProgressScale}"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{Binding UpdateText}" Margin="10,4" Foreground="#FFF0F0F0"/>
                    </Grid>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE768;" FontSize="13"
                        Cursor="Hand" Click="Show_Click" ToolTip="Shows"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" FontSize="13"
                        Cursor="Hand" Click="Settings_Click" ToolTip="Settings"/>
                <Button Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" Click="Min_Click"/>
                <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" Click="Max_Click"/>
                <Button Style="{StaticResource CaptionClose}"
                        Content="&#xE8BB;" Click="Close_Click"/>
            </StackPanel>
        </Grid>

    <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== Device list ===================== -->
        <Border Style="{StaticResource Card}" Grid.Column="0" Grid.Row="0" Margin="0,0,12,0">
            <views:LeftNavPanel/>
        </Border>

        <!-- ============ Right panel: one pane visible at a time (each gates its own
             Visibility on the view model), all sharing the window's DataContext ============ -->
        <Border Style="{StaticResource Card}" Grid.Column="1" Grid.Row="0">
          <Grid>
            <views:LightingPane/>
            <views:LcdDesignerPane/>
            <views:CoolingPane/>

            <!-- ===================== Disabled device ===================== -->
            <StackPanel Visibility="{Binding ShowDisabledPane, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <TextBlock Text="{Binding SelectedLeftItem.Name}" FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="This device is disabled. Other RGB software can control it. Its colors stay saved in your profiles."
                           Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0"/>
                <Button Content="Enable device" Style="{StaticResource Accent}"
                        HorizontalAlignment="Center" Margin="0,20,0,0" Command="{Binding EnableDeviceCommand}"/>
            </StackPanel>

            <views:SettingsPane/>
            <views:ShowPane/>
          </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
