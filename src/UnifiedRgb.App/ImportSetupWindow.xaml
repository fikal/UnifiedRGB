<Window x:Class="UnifiedRgb.App.ImportSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import setup" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="840" MaxHeight="880"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Drag_Down" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="#FF1B1D24" CornerRadius="12" Padding="22"
            BorderBrush="#FF2A2E38" BorderThickness="1">
        <!-- Two panels in one cell, one visible at a time: the chooser, then
             the report. Growing the window in place keeps the user where they
             already are instead of throwing a second dialog at them. -->
        <Grid>

            <!--=================== THE CHOOSER ===================-->
            <Grid x:Name="ChooserPanel">
                <!-- Grid, not a StackPanel: when MaxHeight bites, the middle
                     row scrolls and the Import row stays on screen. A
                     StackPanel pushes the buttons off the bottom edge. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="Import setup" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SourceLine" Opacity="0.6" FontSize="12" Margin="0,3,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="PathLine" Opacity="0.38" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Padding="8,3" Click="Cancel_Click" ToolTip="Close without importing"/>
                </Grid>

                <!-- refusal: the bundle could not be read at all -->
                <Border x:Name="ProblemCard" Grid.Row="1" Background="#FF3A2630" CornerRadius="8"
                        BorderBrush="#FFC03040" BorderThickness="1" Padding="14,12" Margin="0,10,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="This file cannot be imported" FontWeight="SemiBold"
                                   Foreground="#FFFF9AA6"/>
                        <TextBlock x:Name="ProblemText" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- everything the user chooses between -->
                <ScrollViewer x:Name="BodyScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              Margin="0,12,0,0">
                    <!-- The right margin is the gap between the cards and the
                         scroll bar. Without it the rounded corners run straight
                         into the track, which reads as a rendering fault rather
                         than a layout. Kept on the content rather than the
                         ScrollViewer so the spacing is there whether or not the
                         bar is currently showing. -->
                    <StackPanel Margin="0,0,10,0">

                        <!-- The preview's own sentences, shown verbatim. They
                             are written for a person and say more in five lines
                             than the checkbox list says in fifty. -->
                        <Border Background="#FF14161C" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="WHAT THIS WOULD DO" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding SummaryLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#x2022;" Opacity="0.45"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                           Opacity="0.85"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- warnings: not fatal, but never hidden -->
                        <Border x:Name="WarningsCard" Background="#FF2E2718" CornerRadius="8"
                                BorderBrush="#FF7A6420" BorderThickness="1" Padding="14,12" Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="WORTH KNOWING" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FFE0C169" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding WarningLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.85"
                                                       Margin="0,0,0,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- the two one-click answers -->
                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Select the safe set" Padding="14,5" Click="SafeSet_Click"
                                        ToolTip="Add everything you are missing and leave anything that would overwrite your own work untouched"/>
                                <Button Content="Take everything" Padding="14,5" Margin="8,0,0,0"
                                        Click="Everything_Click"
                                        ToolTip="Restore this backup over the top: every item, conflicts included. Replaced files are still backed up first."/>
                            </StackPanel>
                            <TextBlock x:Name="SelectionCount" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Opacity="0.6" FontSize="12"/>
                        </Grid>

                        <!-- the categories -->
                        <ItemsControl ItemsSource="{Binding Sections}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#FF9AA3B2" VerticalAlignment="Center"/>
                                            <!-- The section's aside, in a faint
                                                 pill so it reads as a label
                                                 rather than as dimmed body text
                                                 that failed to load. -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                    CornerRadius="9" Padding="8,2">
                                                <TextBlock Text="{Binding Note}" FontSize="11"
                                                           Foreground="#FF98A1AE"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding RowBackground}" CornerRadius="8"
                                                            Padding="10,8" Margin="0,0,0,5"
                                                            BorderBrush="{Binding RowBorder}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="118"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                                                      Click="Selection_Changed"
                                                                      ToolTip="{Binding CheckHint}"/>

                                                            <!-- The badge, not a tint: a conflict has to be
                                                                 readable at a glance and legible to anyone who
                                                                 cannot tell the two dark reds apart. -->
                                                            <Border Grid.Column="1" Background="{Binding StatusBrush}"
                                                                    CornerRadius="4" Padding="7,3" Height="21"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                                           FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                        Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detail}" Opacity="0.55"
                                                                           FontSize="11" Margin="0,2,0,0"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- swatches: a union merge, so it has no conflict state to show -->
                        <Border x:Name="SwatchCard" Background="#FF262932" CornerRadius="8" Padding="10,8"
                                Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="SwatchBox" VerticalAlignment="Center" Margin="0,0,12,0"
                                          Click="Selection_Changed"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Color swatches" FontWeight="SemiBold"/>
                                    <TextBlock Text="The saved color squares are merged in, never replaced, so none of yours can be lost."
                                               Opacity="0.55" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- devices -->
                        <StackPanel x:Name="DeviceSection" Visibility="Collapsed">
                            <Grid>
                                <TextBlock Text="DEVICES" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" VerticalAlignment="Center"/>
                                <!-- Same pill as the other section asides. The
                                     arrow is the one drawn between each bundle
                                     device and its local target below, so the
                                     hint points at the thing it describes. -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                        CornerRadius="9" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2192;" FontSize="11" Foreground="#FF7FB4FF"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Lighting follows the device you point it at"
                                                   FontSize="11" Foreground="#FF98A1AE" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DeviceRows}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FF262932" CornerRadius="8" Padding="10,8" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="180"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding BundleName}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding BundleDescription}" Opacity="0.5"
                                                               FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}"
                                                               Opacity="0.9" FontSize="11" Margin="0,3,0,0"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="&#x2192;" Opacity="0.4" Margin="0,0,10,0"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox Width="240" VerticalAlignment="Center"
                                                              ItemsSource="{Binding LocalChoices}"
                                                              SelectedItem="{Binding SelectedLocal}"
                                                              ToolTip="Which device on THIS machine the bundle's lighting for this device should land on"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- footer -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FF3E9B62" CornerRadius="4" Padding="7,3" Height="21"
                                VerticalAlignment="Center">
                            <TextBlock Text="NEW" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="adds only" Opacity="0.5" FontSize="11" Margin="6,0,14,0"
                                   VerticalAlignment="Center"/>
                        <Border Background="#FFC03040" CornerRadius="4" Padding="7,3" Height="21"
                                VerticalAlignment="Center">
                            <TextBlock Text="OVERWRITES" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="replaces what you have (the old file is backed up first)" Opacity="0.5"
                                   FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Padding="16,5" Click="Cancel_Click"/>
                        <Button x:Name="ImportButton" Content="Import" Style="{StaticResource Accent}"
                                Padding="22,5" Margin="8,0,0,0" Click="Import_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!--=================== THE REPORT ===================-->
            <!-- A silent success on a screen that just rewrote the user's
                 profiles is unnerving, so the window says what changed, where
                 the replaced files went, and whether to restart. -->
            <Grid x:Name="ResultPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="ResultHeading" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ResultSubHeading" Opacity="0.6" FontSize="12" Margin="0,3,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <Border x:Name="ResultProblemCard" Background="#FF3A2630" CornerRadius="8"
                                BorderBrush="#FFC03040" BorderThickness="1" Padding="14,12"
                                Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="ResultProblemText" TextWrapping="Wrap" Foreground="#FFFF9AA6"/>
                        </Border>

                        <Border x:Name="AppliedCard" Background="#FF14161C" CornerRadius="8" Padding="14,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="CHANGED" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding AppliedLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#x2713;" Foreground="#FF6BD08D"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                           Opacity="0.85"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="BackupCard" Background="#FF262932" CornerRadius="8" Padding="14,12"
                                Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Your replaced files were kept" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BackupPathText" Opacity="0.55" FontSize="11"
                                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Open folder" Padding="14,5"
                                        VerticalAlignment="Center" Click="OpenBackup_Click"/>
                            </Grid>
                        </Border>

                        <Border x:Name="RestartCard" Background="#FF2E2718" CornerRadius="8"
                                BorderBrush="#FF7A6420" BorderThickness="1" Padding="14,12" Margin="0,10,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Restart UnifiedRGB to finish" FontWeight="SemiBold"
                                           Foreground="#FFE0C169"/>
                                <TextBlock Text="The machine wiring files were replaced. Header layouts, hub layouts and fan curves are read once when their drivers open, so they keep the old values until the app is restarted."
                                           Opacity="0.8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="Done" Style="{StaticResource Accent}" Padding="22,5" Click="Done_Click"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
