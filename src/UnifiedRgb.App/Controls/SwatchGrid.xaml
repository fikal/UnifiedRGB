<UserControl x:Class="UnifiedRgb.App.Controls.SwatchGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:UnifiedRgb.App.Controls">
    <!-- A wrap of color swatches: click = PickCommand(color), right-click =
         RemoveCommand(color) when one is set. One control for the five grids the
         panes used to spell out (preset swatches + custom colors, lighting and LCD). -->
    <ItemsControl ItemsSource="{Binding Colors, RelativeSource={RelativeSource AncestorType={x:Type controls:SwatchGrid}}}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Width="{Binding SwatchSize, RelativeSource={RelativeSource AncestorType={x:Type controls:SwatchGrid}}}"
                        Height="{Binding SwatchSize, RelativeSource={RelativeSource AncestorType={x:Type controls:SwatchGrid}}}"
                        Margin="{Binding SwatchMargin, RelativeSource={RelativeSource AncestorType={x:Type controls:SwatchGrid}}}"
                        Background="{Binding Converter={StaticResource RgbToBrush}}"
                        Command="{Binding PickCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:SwatchGrid}}}"
                        CommandParameter="{Binding}">
                    <Button.InputBindings>
                        <MouseBinding Gesture="RightClick"
                                      Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:SwatchGrid}}}"
                                      CommandParameter="{Binding}"/>
                    </Button.InputBindings>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
