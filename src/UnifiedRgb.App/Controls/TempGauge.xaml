<UserControl x:Class="UnifiedRgb.App.Controls.TempGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="150" Height="150">
    <Grid>
        <Path x:Name="Track" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Stroke="#FF262B36"/>
        <Path x:Name="Arc" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="ValueText" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Text="—"/>
            <TextBlock x:Name="LabelText" FontSize="12" Opacity="0.55" HorizontalAlignment="Center"
                       Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
