<UserControl x:Class="UnifiedRgb.App.Controls.FanCurveEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Background="#FF181B22" CornerRadius="8" Padding="10">
        <Canvas x:Name="Plot" ClipToBounds="False"
                Background="Transparent" SizeChanged="Plot_SizeChanged"
                MouseLeftButtonDown="Plot_MouseDown"/>
    </Border>
</UserControl>
