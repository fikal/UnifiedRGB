<Window x:Class="UnifiedRgb.App.LianLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arrange fans" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Drag_Down">
    <Border x:Name="RootPanel" Background="#FF1B1D24" CornerRadius="12" Padding="22"
            BorderBrush="#FF2A2E38" BorderThickness="1"
            AllowDrop="True" PreviewDragOver="Root_PreviewDragOver">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                <TextBlock Text="Arrange fans" FontSize="18" FontWeight="SemiBold"/>
                <Button Content="✕" HorizontalAlignment="Right" Padding="8,3" Click="Close_Click"/>
            </Grid>
            <TextBlock Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Drag the fans into the order they sit in your case, TOP first. Group effects flow down this order. Check New group to split the stack into separate effect canvases."/>

            <TextBlock Text="TOP OF THE STACK" FontSize="10" FontWeight="SemiBold"
                       Foreground="#FF9AA3B2" Opacity="0.7" Margin="2,0,0,6"/>
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF262932" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                BorderThickness="0,2,0,2" BorderBrush="Transparent"
                                AllowDrop="True" DragOver="Row_DragOver" DragLeave="Row_DragLeave" Drop="Row_Drop"
                                PreviewMouseLeftButtonDown="Row_Down" PreviewMouseMove="Row_Move"
                                Cursor="SizeAll">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⠿" Opacity="0.45" FontSize="15" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="2" Content="New group" IsChecked="{Binding NewGroup}"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding CanBreak, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Effects for this group start fresh here instead of continuing from the fan above"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="BOTTOM" FontSize="10" FontWeight="SemiBold"
                       Foreground="#FF9AA3B2" Opacity="0.7" Margin="2,0,0,0"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Padding="14,5" Click="Close_Click"/>
                <Button Content="Save" Style="{StaticResource Accent}" Padding="16,5" Margin="8,0,0,0" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
