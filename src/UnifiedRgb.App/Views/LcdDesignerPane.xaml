<UserControl x:Class="UnifiedRgb.App.Views.LcdDesignerPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnifiedRgb.App"
             xmlns:controls="clr-namespace:UnifiedRgb.App.Controls"
             DataContext="{Binding Lcd}">
    <!-- ===================== Pump LCD designer ===================== -->
    <!-- DataContext = MainViewModel.Lcd. The few things owned by the main view
         model (pane visibility, the shared swatches/custom colors and their
         commands) are reached through the window. -->
            <DockPanel Visibility="{Binding DataContext.ShowLcdPanel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                <TextBlock DockPanel.Dock="Top" Text="Pump LCD" FontSize="20" FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <!-- CPU temp needs elevation -->
                <Border DockPanel.Dock="Top" Background="#33FFB020" CornerRadius="7" Padding="10,7" Margin="0,0,0,12"
                        Visibility="{Binding CpuTempUnavailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="CPU temp needs admin rights (PawnIO sensor driver)."
                                   VerticalAlignment="Center" Opacity="0.9"/>
                        <Button Content="Restart as admin" Command="{Binding RelaunchElevatedCommand}"
                                Style="{StaticResource Accent}" Margin="12,0,0,0" Padding="10,4"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- WYSIWYG editor canvas (landscape 320x240, drag to place) -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Border CornerRadius="10" Background="#FF0C0E14" Padding="6" HorizontalAlignment="Left">
                            <Grid Width="320" Height="240" ClipToBounds="True">
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF0C1028" Offset="0"/>
                                            <GradientStop Color="#FF3C0C3C" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- Background at its explicit rect — the SAME rect the
                                     panel renders, so the preview is truthful. Drag empty
                                     canvas to move it; corner grip resizes. -->
                                <Canvas ClipToBounds="True">
                                    <Image Source="{Binding LcdBackground}" Stretch="Fill"
                                           Canvas.Left="{Binding LcdBgX}" Canvas.Top="{Binding LcdBgY}"
                                           Width="{Binding LcdBgW}" Height="{Binding LcdBgH}"/>
                                </Canvas>
                                <ListBox x:Name="DesignCanvas" Background="Transparent" BorderThickness="0"
                                         ItemsSource="{Binding LcdElements}" SelectedItem="{Binding SelectedElement}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="Design_Down"
                                         PreviewMouseMove="Design_Move"
                                         PreviewMouseLeftButtonUp="Design_Up"
                                         LostMouseCapture="Design_LostCapture">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="bd" BorderThickness="1" BorderBrush="Transparent">
                                                            <ContentPresenter/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="bd" Property="BorderBrush" Value="#CC4C6FFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <!-- Drawn elements (analog clock) show a live face image;
                                                     everything else is typeset text. -->
                                                <TextBlock Text="{Binding Display}"
                                                           FontFamily="Segoe UI"
                                                           FontSize="{Binding FontSize}"
                                                           FontWeight="{Binding Bold, Converter={StaticResource BoolWeight}}"
                                                           Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                                           Visibility="{Binding IsClock, Converter={StaticResource BoolToVisInv}}"/>
                                                <Image Source="{Binding ClockImage}"
                                                       Width="{Binding ClockSize}" Height="{Binding ClockSize}"
                                                       Visibility="{Binding IsClock, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Canvas>
                                    <Border Width="14" Height="14" Background="#CC4C6FFF" CornerRadius="3"
                                            Canvas.Left="{Binding LcdBgGripX}" Canvas.Top="{Binding LcdBgGripY}"
                                            Cursor="SizeNWSE" ToolTip="Drag to resize the background"
                                            Visibility="{Binding LcdHasBackground, Converter={StaticResource BoolToVis}}"
                                            MouseLeftButtonDown="BgGrip_Down" MouseMove="BgGrip_Move"
                                            MouseLeftButtonUp="BgGrip_Up" LostMouseCapture="BgGrip_LostCapture"/>
                                </Canvas>
                            </Grid>
                        </Border>
                        <TextBlock Text="Drag items to place them · click to select" Opacity="0.45"
                                   FontSize="11" Margin="2,8,0,0"/>
                    </StackPanel>

                    <!-- Right side: one tab per task, so only the tools for the
                         job at hand are on screen -->
                    <TabControl x:Name="LcdTabs" Grid.Column="1" Background="Transparent"
                                BorderThickness="0" Padding="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TabItem">
                                            <Border x:Name="bd" CornerRadius="8" Padding="18,7" Margin="0,0,8,12"
                                                    Background="#FF262932" Cursor="Hand">
                                                <TextBlock x:Name="txt" Text="{TemplateBinding Header}"
                                                           FontWeight="SemiBold" Foreground="#FFECEFF4" Opacity="0.7"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF4C6FFF"/>
                                                    <Setter TargetName="txt" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="bd" Property="Background" Value="#FF313644"/>
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TabControl.Resources>

                        <!-- ============ DESIGN: what's on the screen ============ -->
                        <TabItem Header="Design">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,14,0" MaxWidth="560" HorizontalAlignment="Left">
                                <TextBlock Text="ADD TO SCREEN" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="+ Time"     Command="{Binding AddTimeCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ Date"     Command="{Binding AddDateCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ CPU Temp" Command="{Binding AddTempCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ GPU Temp" Command="{Binding AddGpuTempCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ Fan RPM"  Command="{Binding AddFanRpmCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ Net"      Command="{Binding AddNetSpeedCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ Clock"    Command="{Binding AddClockCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ Weather"  Command="{Binding AddWeatherCommand}" Margin="0,0,8,8"/>
                                    <Button Content="+ Text"     Command="{Binding AddTextCommand}" Margin="0,0,8,8"/>
                                </WrapPanel>

                                <TextBlock Text="ELEMENT" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,14,0,8"/>
                                <TextBlock Text="Click an item on the screen to change its size and color."
                                           Opacity="0.5" TextWrapping="Wrap"
                                           Visibility="{Binding HasElement, Converter={StaticResource BoolToVisInv}}"/>
                        <StackPanel Visibility="{Binding HasElement, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectedElement.Label}" FontSize="16" FontWeight="SemiBold"/>

                            <StackPanel Visibility="{Binding IsCustomText, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Text" Opacity="0.7" Margin="0,14,0,4"/>
                                <TextBox Text="{Binding SelectedElement.Text, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <TextBlock Text="Size" Opacity="0.7" Margin="0,14,0,2"/>
                            <Slider Minimum="10" Maximum="120" Value="{Binding SelectedElement.FontSize}"/>

                            <CheckBox Content="Bold" IsChecked="{Binding SelectedElement.Bold}" Margin="0,10,0,0"/>

                            <TextBlock Text="Color" Opacity="0.7" Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <local:ColorWheel Width="150" Height="150"
                                                  SelectedColor="{Binding SelectedElementColor, Mode=TwoWay}"/>
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="34" Height="34" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{Binding SelectedElement.ColorHex, Converter={StaticResource HexBrush}}"/>
                                        <TextBox Width="92" Margin="10,0,0,0" FontFamily="Consolas"
                                                 VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                                 Text="{Binding SelectedElement.ColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="R" Foreground="#FFFF5555" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox Width="56" Margin="6,0,10,0" HorizontalContentAlignment="Center"
                                                 Text="{Binding ElemR, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="G" Foreground="#FF58D858" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox Width="56" Margin="6,0,10,0" HorizontalContentAlignment="Center"
                                                 Text="{Binding ElemG, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="B" Foreground="#FF6E96FF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox Width="56" Margin="6,0,0,0" HorizontalContentAlignment="Center"
                                                 Text="{Binding ElemB, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DataContext.Swatches, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="3"
                                                Background="{Binding Converter={StaticResource RgbToBrush}}"
                                                Command="{Binding DataContext.Lcd.PickElementColorCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Custom colors -->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Custom" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button Content="+ add current" Padding="8,4" Margin="10,0,0,0"
                                        Command="{Binding DataContext.AddCustomElementColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <TextBlock Text="right-click removes" Opacity="0.4" FontSize="11"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DataContext.CustomColors, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="26" Height="26" Margin="3"
                                                Background="{Binding Converter={StaticResource RgbToBrush}}"
                                                Command="{Binding DataContext.Lcd.PickElementColorCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.InputBindings>
                                                <MouseBinding Gesture="RightClick"
                                                              Command="{Binding DataContext.RemoveCustomColorCommand,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Button.InputBindings>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Delete element" Command="{Binding DeleteElementCommand}"
                                    HorizontalAlignment="Left" Margin="0,18,0,0"/>
                        </StackPanel>

                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>

                        <!-- ============ BACKGROUND: the image behind everything ============ -->
                        <TabItem Header="Background">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,14,0" MaxWidth="520" HorizontalAlignment="Left">
                                <TextBlock Opacity="0.6" TextWrapping="Wrap"
                                           Text="The image behind everything on the screen. GIFs animate on the pump."/>

                                <TextBlock Text="IMAGE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,16,0,8"/>
                                <WrapPanel>
                                    <Button Content="Choose image…" Command="{Binding ChooseBackgroundCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Clear" Command="{Binding ClearBackgroundCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding LcdHasBackground, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding LcdBackgroundName}" Opacity="0.6" FontSize="11"
                                               VerticalAlignment="Center"/>
                                </WrapPanel>

                                <StackPanel Visibility="{Binding LcdHasBackground, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="SIZE &amp; PLACEMENT" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,16,0,8"/>
                                    <WrapPanel>
                                        <TextBox Text="{Binding LcdBgW, StringFormat=0, UpdateSourceTrigger=LostFocus}" Width="52"
                                                 HorizontalContentAlignment="Center" ToolTip="Width (px)"/>
                                        <TextBlock Text="×" Opacity="0.6" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBox Text="{Binding LcdBgH, StringFormat=0, UpdateSourceTrigger=LostFocus}" Width="52"
                                                 HorizontalContentAlignment="Center" ToolTip="Height (px)"/>
                                        <CheckBox Content="Lock aspect" IsChecked="{Binding LcdBgAspectLock}" Margin="12,0,0,0"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Keep the image's shape when resizing (no squash/stretch)"/>
                                        <Button Content="Fill" Click="BgFill_Click" Padding="10,4" Margin="14,0,0,0"
                                                ToolTip="Cover the whole screen (crops the overflow)"/>
                                        <Button Content="Fit" Click="BgFit_Click" Padding="10,4" Margin="6,0,0,0"
                                                ToolTip="Show the whole image (bars around it)"/>
                                        <Button Content="Center" Click="BgCenter_Click" Padding="10,4" Margin="6,0,0,0"/>
                                    </WrapPanel>
                                    <TextBlock Text="On the preview: drag the image to move it, drag the blue corner grip to resize."
                                               Opacity="0.4" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>

                        <!-- ============ SCREENS (scenes in code): saved layouts ============ -->
                        <TabItem Header="Screens">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,14,0" MaxWidth="480" HorizontalAlignment="Left">
                                <TextBlock Opacity="0.6" TextWrapping="Wrap"
                                           Text="A screen is a saved layout for the pump display. Load one to edit it, or save what you have now."/>

                                <TextBlock Text="LOAD" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,16,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="180" ItemsSource="{Binding SceneNames}"
                                              SelectedItem="{Binding SelectedSceneName}"
                                              ToolTip="Pick a screen to load it"/>
                                    <Button Content="Delete" Style="{StaticResource Danger}" Padding="10,4"
                                            Margin="8,0,0,0" Click="DeleteScene_Click"/>
                                </StackPanel>

                                <TextBlock Text="SAVE" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,16,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="180" Text="{Binding SceneNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Name for the screen"/>
                                    <Button Content="Save screen" Style="{StaticResource Accent}" Padding="12,4"
                                            Margin="8,0,0,0" Click="SaveScene_Click"/>
                                </StackPanel>
                                <TextBlock Text="New name = new screen. Empty name = update the loaded one."
                                           Opacity="0.45" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>

                        <!-- ============ SHOW: timed screen + lights changes ============ -->
                        <TabItem Header="Show">
                          <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,2,14,0" MaxWidth="700" HorizontalAlignment="Left">
                                <TextBlock Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Text="A show changes your screen and lights on a timer. It loops until you stop it."/>

                                <TextBlock Text="SHOW" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="180" ItemsSource="{Binding Sequences}"
                                              SelectedItem="{Binding SelectedSequence}"/>
                                    <TextBox Width="140" Margin="8,0,0,0"
                                             Text="{Binding SceneNameInput, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Name for a new show"/>
                                    <Button Content="New" Padding="12,0" Height="32" VerticalAlignment="Center"
                                            Margin="8,0,0,0" Click="NewSequence_Click"
                                            ToolTip="Create a show with the typed name"/>
                                    <Button Content="Delete" Style="{StaticResource Danger}" Padding="12,0" Height="32"
                                            VerticalAlignment="Center" Margin="6,0,0,0" Click="DeleteSequence_Click"/>
                                </StackPanel>

                                <TextBlock Text="STEPS" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,16,0,4"/>
                                <TextBlock Opacity="0.5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Each step waits, then changes the screen, the lights, or both. Pick (no change) to leave that part alone."/>

                                <ItemsControl ItemsSource="{Binding SequenceActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FF262932" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="wait" Opacity="0.7" VerticalAlignment="Center"/>
                                                    <!-- Explicit dark fill (the app TextBox color matches the step
                                                         card); no fixed Height - the style's padding needs ~34px and
                                                         a shorter box clips the digits out of view -->
                                                    <TextBox Width="44" Margin="6,0,4,0" VerticalAlignment="Center"
                                                             HorizontalContentAlignment="Center"
                                                             Background="#FF15171D"
                                                             Text="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"/>
                                                    <TextBlock Text="sec" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <TextBlock Text="screen" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox Width="130" VerticalAlignment="Center"
                                                              ItemsSource="{Binding DataContext.Lcd.SceneChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Scene, TargetNullValue=(no change)}"
                                                              ToolTip="What the pump screen shows on this step"/>
                                                    <TextBlock Text="lights" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                                    <ComboBox Width="130" VerticalAlignment="Center"
                                                              ItemsSource="{Binding DataContext.Lcd.ProfileChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedItem="{Binding Profile, TargetNullValue=(no change)}"
                                                              ToolTip="What the lights do on this step"/>
                                                    <Button Content="&#x2191;" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                                                            Margin="10,0,0,0" Click="ActionUp_Click" ToolTip="Move up"/>
                                                    <Button Content="&#x2193;" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                                                            Margin="4,0,0,0" Click="ActionDown_Click" ToolTip="Move down"/>
                                                    <Button Content="&#x2715;" Style="{StaticResource Danger}" Width="28" Height="28" Padding="0"
                                                            VerticalAlignment="Center" Margin="6,0,0,0"
                                                            Click="ActionRemove_Click" ToolTip="Remove this step"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="+ Add step" Padding="12,0" Height="32" VerticalAlignment="Center" Click="AddAction_Click"/>
                                    <Button Content="{Binding RunButtonText}" Style="{StaticResource Accent}"
                                            Padding="18,0" Height="32" VerticalAlignment="Center" Margin="10,0,0,0" Click="RunSequence_Click"/>
                                    <CheckBox Content="Start with the app" IsChecked="{Binding SequenceActiveAtStartup}"
                                              VerticalAlignment="Center" Margin="14,0,0,0"
                                              ToolTip="This show starts by itself when UnifiedRGB opens"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SequenceStatus}" Opacity="0.6" FontSize="11" Margin="0,6,0,0"/>

                                <Border Background="#FF1E212A" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                    <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                                               Text="Try it: save two profiles with different colors. Add a step for each one (wait 1 sec, lights = that profile). Hit Run and your lights flash back and forth."/>
                                </Border>
                            </StackPanel>
                          </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </DockPanel>
</UserControl>
