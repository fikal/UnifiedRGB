<UserControl x:Class="UnifiedRgb.App.Views.ShowPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnifiedRgb.App">
    <!-- ===================== Shows =====================
         A timeline of PROFILES, and therefore of the whole desk: the lights,
         the pump panel and the screen in the case all travel on the profile a
         step names. It used to be a tab inside the pump LCD designer, which
         filed it under the smallest of the three things it drives.

         Its DataContext is the main view model's Shows. -->
    <!-- Plain bindings against the inherited DataContext, exactly as SettingsPane
         does. RelativeSource AncestorType=Window makes the WINDOW the source, so
         the path is looked up on MainWindow rather than on its DataContext -
         which finds nothing, fails silently, and left this page permanently
         visible on top of the lighting pane. -->
    <ScrollViewer Visibility="{Binding IsShowOpen, Converter={StaticResource BoolToVis}}"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left" Margin="0,0,14,0"
                    DataContext="{Binding Shows}">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="&#x2190;  Back" Padding="10,6" Click="Back_Click" ToolTip="Back to devices"/>
                <TextBlock Text="Shows" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
    <StackPanel Margin="0,2,14,0" MaxWidth="700" HorizontalAlignment="Left">
        <TextBlock Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="A show steps through your profiles on a timer, taking the lights, the pump panel and the screen in the case with it. It loops until you stop it."/>

        <TextBlock Text="SHOW" FontSize="11" FontWeight="SemiBold"
                   Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal">
            <ComboBox Width="180" Height="28" VerticalAlignment="Center"
                      ItemsSource="{Binding Shows}"
                      SelectedItem="{Binding SelectedShow}"/>
            <TextBox Width="140" MinHeight="28" Padding="6,3" VerticalAlignment="Center"
                     Margin="8,0,0,0"
                     Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Name for a new show"/>
            <Button Content="New" Padding="14,0" Height="28" VerticalAlignment="Center"
                    Margin="8,0,0,0" Click="NewShow_Click"
                    ToolTip="Create a show with the typed name"/>
            <Button Content="Delete" Style="{StaticResource Danger}" Padding="14,0" Height="28"
                    VerticalAlignment="Center" Margin="6,0,0,0" Click="DeleteShow_Click"/>
        </StackPanel>

        <TextBlock Text="STEPS" FontSize="11" FontWeight="SemiBold"
                   Foreground="#FF9AA3B2" Opacity="0.8" Margin="0,16,0,4"/>
        <TextBlock Opacity="0.5" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Each step waits, then goes to a profile."/>

        <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FF262932" CornerRadius="8" Padding="10,5" Margin="0,0,0,6">
                        <!-- Grid, not a StackPanel: a stack keeps its natural width, so on a
                             narrower pane the row overflowed its card and clipped the remove
                             button off the right edge. The two dropdowns share the slack
                             instead, and the buttons are always reachable. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="86"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="86"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="wait" Opacity="0.7" VerticalAlignment="Center"/>
                            <!-- Explicit dark fill: the app TextBox color matches the step
                                 card. Pinning the height is only safe because the padding is
                                 trimmed with it; the style's default 6,7 needs ~34px and
                                 clips the digits in a shorter box. -->
                            <TextBox Grid.Column="1" Width="44" MinHeight="28" Padding="6,3"
                                     Margin="6,0,4,0" VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Background="#FF15171D"
                                     Text="{Binding DelaySeconds, UpdateSourceTrigger=LostFocus, StringFormat=0.#}"/>
                            <TextBlock Grid.Column="2" Text="sec" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Grid.Column="3" Text="go to" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Grid.Column="4" Grid.ColumnSpan="3" Height="28" VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch" Margin="0,0,12,0"
                                      ItemsSource="{Binding DataContext.Shows.ProfileChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectedItem="{Binding Profile, TargetNullValue=(no change)}"
                                      ToolTip="The profile this step goes to: the lights, the pump panel and the screen in the case together"/>
                            <Button Grid.Column="7" Content="&#x2191;" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                                    Margin="10,0,0,0" Click="StepUp_Click" ToolTip="Move up"/>
                            <Button Grid.Column="8" Content="&#x2193;" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                                    Margin="4,0,0,0" Click="StepDown_Click" ToolTip="Move down"/>
                            <Button Grid.Column="9" Content="&#x2715;" Style="{StaticResource Danger}" Width="28" Height="28" Padding="0"
                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                    Click="StepRemove_Click" ToolTip="Remove this step"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="+ Add step" Padding="14,0" Height="28" VerticalAlignment="Center" Click="AddStep_Click"/>
            <Button Content="{Binding RunButtonText}" Style="{StaticResource Accent}"
                    Padding="18,0" Height="28" VerticalAlignment="Center" Margin="10,0,0,0" Click="RunShow_Click"/>
            <Button Content="{Binding PauseButtonText}"
                    Padding="14,0" Height="28" VerticalAlignment="Center" Margin="10,0,0,0"
                    Click="PauseShow_Click"
                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                    ToolTip="Hold the show where it is and carry on from the same step"/>
            <TextBlock Text="Starts when a profile asks for it" Opacity="0.6" FontSize="11"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       ToolTip="Bind this show to a profile under Settings, Profiles. A profile is the one switch for the lights, the pump panel and the screen in the case."/>
        </StackPanel>
        <TextBlock Text="{Binding Status}" Opacity="0.6" FontSize="11" Margin="0,6,0,0"/>

        <Border Background="#FF1E212A" CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
            <TextBlock Opacity="0.65" FontSize="12" TextWrapping="Wrap"
                       Text="Try it: save two profiles with different colors, add a step for each, set both waits to 1 second and hit Run. Your lights flash back and forth."/>
        </Border>
    </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
