<UserControl x:Class="UnifiedRgb.App.Views.LightingPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnifiedRgb.App"
             xmlns:controls="clr-namespace:UnifiedRgb.App.Controls">
    <!-- ===================== Lighting ===================== -->
            <DockPanel Visibility="{Binding ShowLighting, Converter={StaticResource BoolToVis}}">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Height pinned to the Zone combo's 34px so the row reads
                             identically whether or not the combo is present. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                    Visibility="{Binding ShowLianSpeed, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Fan speed" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                            <Slider Width="120" Minimum="0.3" Maximum="4" Value="{Binding LianSpeedScale}"
                                    VerticalAlignment="Center"
                                    ToolTip="Drag until the fan animation keeps pace with your other lights (right = slower)."/>
                            <TextBlock Text="{Binding LianSpeedText}" VerticalAlignment="Center" Opacity="0.7"
                                       Margin="8,0,0,0" MinWidth="34"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                    Visibility="{Binding ShowLianUniChannel, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Channel" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                            <ComboBox Width="110" VerticalAlignment="Center"
                                      ItemsSource="{Binding LianUniChannelOptions}"
                                      DisplayMemberPath="Label" SelectedValuePath="Channel"
                                      SelectedValue="{Binding LianUniChannel}"
                                      ToolTip="Which controller connector your fans are plugged into (only connectors with fans are listed)."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                    Visibility="{Binding ShowLianUni, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Fans" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                            <ComboBox Width="60" VerticalAlignment="Center"
                                      ItemsSource="{Binding LianUniFanOptions}"
                                      SelectedItem="{Binding LianUniFanCount}"
                                      ToolTip="How many fans are daisy-chained on this channel (up to 4)."/>
                        </StackPanel>
                        <Button Content="Arrange fans…" Height="34" Padding="10,0" Margin="0,0,14,0"
                                Visibility="{Binding ShowArrangeFans, Converter={StaticResource BoolToVis}}"
                                Click="ArrangeFans_Click"
                                ToolTip="Drag the fans into the order they sit in your case; split them into groups"/>
                        <Button Content="Disable" Style="{StaticResource Danger}" Height="34" Padding="10,0"
                                Margin="0,0,14,0" Click="DisableDevice_Click"
                                ToolTip="Stop controlling this device so other RGB software can own it. Profiles keep its saved colors and effects."/>
                        <Button Content="Headers…" Height="34" Padding="10,0" Margin="0,0,14,0"
                                Visibility="{Binding IsGigabyteSelected, Converter={StaticResource BoolToVis}}"
                                Click="ConfigureHeaders_Click"
                                ToolTip="Configure which ARGB headers have addressable fans"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ShowZonePicker, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Zone" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="210" ItemsSource="{Binding Targets}"
                                      SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Name"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Night-off banner: scheduled lights-off looked like "nothing works" -->
                <Border DockPanel.Dock="Top" Background="#2B3B63" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding NightLightsOff, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌙" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Night mode has the lights off. Changing anything wakes them."
                                   VerticalAlignment="Center" Opacity="0.9"/>
                        <Button Content="Wake lights" Style="{StaticResource Accent}" Padding="12,4"
                                Margin="12,0,0,0" Click="WakeLights_Click"/>
                    </StackPanel>
                </Border>

                <!-- Mode pills: favorites + Custom Pattern; the library lives
                     behind All effects (star an effect there to pin it here) -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="AllEffectsBtn" DockPanel.Dock="Right" Content="All effects…"
                            VerticalAlignment="Top" Padding="12,7" Margin="8,0,0,0" Click="AllEffects_Click"
                            ToolTip="Browse every effect by category - star the ones you want as pills"/>
                    <ListBox x:Name="PillsList" ItemsSource="{Binding VisibleEffects}"
                             SelectionChanged="Pills_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource Pill}"
                             IsTextSearchEnabled="False" PreviewKeyDown="Pills_PreviewKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <Popup x:Name="EffectsPopup" StaysOpen="False" AllowsTransparency="True"
                       Placement="Bottom" PlacementTarget="{Binding ElementName=AllEffectsBtn}">
                    <Border Background="#FF1B1D24" CornerRadius="10" Padding="16" Margin="0,4,8,8"
                            BorderBrush="#FF2E3140" BorderThickness="1" MaxWidth="620">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="440">
                            <StackPanel>
                                <TextBlock Text="Click an effect to use it · star it to pin it to the bar"
                                           Opacity="0.5" FontSize="11" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="EffectMenuList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="2,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#FF262932" CornerRadius="15"
                                                                    Margin="0,0,6,6" Padding="2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Click="EffectPick_Click" Cursor="Hand">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" Background="Transparent"
                                                                                        CornerRadius="13" Padding="10,4">
                                                                                    <TextBlock Text="{Binding Name}" Foreground="#FFECEFF4"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#FF313644"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                    <Button Click="EffectStar_Click" Cursor="Hand"
                                                                            Visibility="{Binding CanStar, Converter={StaticResource BoolToVis}}"
                                                                            ToolTip="Favorite = shows as a pill">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="bd" Background="Transparent"
                                                                                        CornerRadius="13" Padding="5,4,9,4">
                                                                                    <TextBlock Text="{Binding Star}" FontSize="13"
                                                                                               Foreground="{Binding StarBrush}"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="bd" Property="Background" Value="#FF313644"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>
                <Border DockPanel.Dock="Top" Background="#18FFFFFF" Height="1" Margin="0,4,0,16"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Settings for the current mode -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Current effect + favorite star (favorites are the pills) -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{Binding CurrentEffectName}" FontSize="17" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Button Click="TitleStar_Click" Cursor="Hand" VerticalAlignment="Center" Margin="8,1,0,0"
                                        Visibility="{Binding ShowCurrentEffectStar, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Favorite = shows as a pill">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="6,2">
                                                <TextBlock Text="{Binding CurrentEffectStar}" FontSize="16"
                                                           Foreground="{Binding CurrentEffectStarBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#FF313644"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <!-- Color controls (static, tinted effects, custom pattern) -->
                            <StackPanel Visibility="{Binding ShowColorControls, Converter={StaticResource BoolToVis}}">
                                <local:ColorWheel Width="190" Height="190" HorizontalAlignment="Left"
                                                  SelectedColor="{Binding WheelColor, Mode=TwoWay}"/>
                                <TextBlock Text="Brightness" Opacity="0.7" Margin="0,10,0,0"/>
                                <Slider Minimum="0" Maximum="255" Value="{Binding Brightness}" Margin="0,2,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="7" Background="{Binding PreviewBrush}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="Consolas" FontSize="14"/>
                                </Grid>
                                <!-- Same width as the swatch+hex row above: aligned on both edges -->
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="R" Foreground="#FFFF5555" FontWeight="SemiBold"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBox HorizontalContentAlignment="Center"
                                                 Text="{Binding R, UpdateSourceTrigger=LostFocus}"/>
                                    </DockPanel>
                                    <DockPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="G" Foreground="#FF58D858" FontWeight="SemiBold"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBox HorizontalContentAlignment="Center"
                                                 Text="{Binding G, UpdateSourceTrigger=LostFocus}"/>
                                    </DockPanel>
                                    <DockPanel Grid.Column="2">
                                        <TextBlock Text="B" Foreground="#FF6E96FF" FontWeight="SemiBold"
                                                   DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBox HorizontalContentAlignment="Center"
                                                 Text="{Binding B, UpdateSourceTrigger=LostFocus}"/>
                                    </DockPanel>
                                </Grid>
                                <controls:SwatchGrid Colors="{Binding Swatches}" SwatchSize="28" PickCommand="{Binding PickSwatchCommand}" Margin="0,10,0,0"/>

                                <!-- Custom colors -->
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="Custom" Opacity="0.7" VerticalAlignment="Center"/>
                                    <Button Content="+ add current" Padding="8,4" Margin="10,0,0,0"
                                            Command="{Binding AddCustomColorCommand}"/>
                                    <TextBlock Text="right-click removes" Opacity="0.4" FontSize="11"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <controls:SwatchGrid Colors="{Binding CustomColors}" SwatchSize="28" PickCommand="{Binding PickSwatchCommand}" RemoveCommand="{Binding RemoveCustomColorCommand}" Margin="0,6,0,0"/>
                            </StackPanel>

                            <!-- Palette editor (Taichi, Gradient, Confetti…): here the palette
                                 IS the color UI, so it leads the column. The wheel and its
                                 hex/RGB friends live in a pop-up behind "+ color" - keeps the
                                 panel short instead of burying the palette under a full picker. -->
                            <StackPanel Visibility="{Binding ShowEffectPalette, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Colors" Opacity="0.7" VerticalAlignment="Center"/>
                                    <Button x:Name="AddColorBtn" Content="+ color" Click="AddPaletteColor_Click"
                                            Margin="12,0,0,0" Padding="8,4"/>
                                    <Button Content="Library…" Click="PaletteLibrary_Click"
                                            Margin="8,0,0,0" Padding="8,4"/>
                                </StackPanel>
                                <controls:PaletteStrip Margin="0,10,0,0" SwatchSize="34" SwatchMargin="0,0,7,7"/>
                                <TextBlock Text="click a swatch to remove it"
                                           Opacity="0.4" FontSize="11" Margin="0,2,0,0"/>

                                <!-- Compact picker pop-up: wheel + brightness + hex + presets,
                                     one Add per pick. Click anywhere else to dismiss. -->
                                <Popup x:Name="AddColorPopup" StaysOpen="False" AllowsTransparency="True"
                                       PlacementTarget="{Binding ElementName=AddColorBtn}" Placement="Bottom"
                                       PopupAnimation="Fade">
                                    <Border Background="#FF1F222B" CornerRadius="10" Padding="14" Margin="10"
                                            BorderBrush="#FF2A2E38" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                                        </Border.Effect>
                                        <StackPanel Width="196">
                                            <local:ColorWheel Width="164" Height="164" HorizontalAlignment="Center"
                                                              SelectedColor="{Binding WheelColor, Mode=TwoWay}"/>
                                            <TextBlock Text="Brightness" Opacity="0.7" Margin="0,8,0,0"/>
                                            <Slider Minimum="0" Maximum="255" Value="{Binding Brightness}" Margin="0,2,0,6"/>
                                            <!-- Compact preview + hex (the global TextBox padding is
                                                 too tall for a pop-up) -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="5" Width="22" Height="22" HorizontalAlignment="Left"
                                                        VerticalAlignment="Center" Background="{Binding PreviewBrush}"/>
                                                <TextBox Grid.Column="1" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                                                         FontFamily="Consolas" FontSize="12" Padding="6,3"
                                                         VerticalContentAlignment="Center"/>
                                            </Grid>
                                            <!-- 7 swatches per row at 28px/cell = exactly 196: no
                                                 clipped right edge -->
                                            <controls:SwatchGrid Colors="{Binding Swatches}" SwatchSize="24" SwatchMargin="2" PickCommand="{Binding PickSwatchCommand}" Margin="0,8,0,0"/>
                                            <Button Content="Add color" Style="{StaticResource Accent}" Margin="0,10,0,0"
                                                    HorizontalAlignment="Stretch" Padding="12,6"
                                                    Command="{Binding AddPaletteColorCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <!-- Apply (static only) + All devices (any mode) -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Apply" Style="{StaticResource Accent}"
                                        Command="{Binding ApplyToTargetCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding IsStaticMode, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="All devices" Command="{Binding ApplyToAllCommand}"
                                        ToolTip="Put this exact mode (color or effect, with its settings) on every device"/>
                            </StackPanel>

                            <!-- Speed (preset animated modes; "Punch" for audio) -->
                            <StackPanel Visibility="{Binding ShowSpeedInMain, Converter={StaticResource BoolToVis}}"
                                        Margin="0,14,0,0">
                                <TextBlock Text="{Binding SpeedLabel}" Opacity="0.7" Margin="0,0,0,2"/>
                                <Slider Minimum="0.1" Maximum="4" Value="{Binding EffectSpeed}"
                                        ToolTip="How hard the lights react to sound. Low = only the peaks, high = always moving."/>
                            </StackPanel>

                            <!-- Direction: reverse any animated effect -->
                            <CheckBox Content="Reverse direction" IsChecked="{Binding EffectReverse}"
                                      Visibility="{Binding ShowDirection, Converter={StaticResource BoolToVis}}"
                                      Margin="0,10,0,0"
                                      ToolTip="Run the effect backwards (sweeps, spins and color flow go the other way)."/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Custom pattern column (its own panel, no scrolling) -->
                    <StackPanel Grid.Column="1" Width="240" Margin="0,0,20,0"
                                Visibility="{Binding IsCustomPattern, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Pattern" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Speed" Opacity="0.7" Margin="0,0,0,2"/>
                        <Slider Minimum="0.1" Maximum="4" Value="{Binding EffectSpeed}"/>
                        <TextBlock Text="Pattern color" Opacity="0.7" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding PatternColorModes}" SelectedItem="{Binding SelectedPatternColor}"/>
                        <TextBlock Text="Motion" Opacity="0.7" Margin="0,12,0,4"/>
                        <ComboBox ItemsSource="{Binding PatternMotions}" SelectedItem="{Binding SelectedPatternMotion}"/>
                        <TextBlock Text="Density" Opacity="0.7" Margin="0,12,0,2"/>
                        <Slider Minimum="1" Maximum="5" Value="{Binding PatternDensity}"/>
                        <CheckBox Content="Reverse direction" IsChecked="{Binding PatternReverse}" Margin="0,10,0,0"/>
                        <StackPanel Visibility="{Binding IsPaletteMode, Converter={StaticResource BoolToVis}}"
                                    Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Palette" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button Content="+ color" Command="{Binding AddPaletteColorCommand}"
                                        Margin="12,0,0,0" Padding="8,4"/>
                                <Button Content="Library…" Click="PaletteLibrary_Click"
                                        Margin="8,0,0,0" Padding="8,4"/>
                            </StackPanel>
                            <TextBlock Text="adds the wheel color · click a swatch to remove"
                                       Opacity="0.4" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <controls:PaletteStrip Margin="0,8,0,0" SwatchSize="28" SwatchMargin="3"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Key Ripple settings (its own panel, like the pattern's) -->
                    <StackPanel Grid.Column="1" Width="240" Margin="0,0,20,0"
                                Visibility="{Binding IsKeyRipple, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Ripple" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Ring color" Opacity="0.7" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PatternColorModes}" SelectedItem="{Binding SelectedRippleColor}"/>
                        <TextBlock Text="Rainbow = every press a new hue · Gradient = cycles your palette · Solid = the wheel color"
                                   Opacity="0.4" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <StackPanel Visibility="{Binding IsRipplePalette, Converter={StaticResource BoolToVis}}"
                                    Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Palette" Opacity="0.7" VerticalAlignment="Center"/>
                                <Button Content="+ color" Command="{Binding AddPaletteColorCommand}"
                                        Margin="12,0,0,0" Padding="8,4"/>
                                <Button Content="Library…" Click="PaletteLibrary_Click"
                                        Margin="8,0,0,0" Padding="8,4"/>
                            </StackPanel>
                            <TextBlock Text="adds the wheel color · click a swatch to remove"
                                       Opacity="0.4" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <controls:PaletteStrip Margin="0,8,0,0" SwatchSize="28" SwatchMargin="3"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live device preview (keyboard replica / fan disc only) -->
                    <Grid Grid.Column="2" Visibility="{Binding ShowGenericPreview, Converter={StaticResource BoolToVis}}"
                          VerticalAlignment="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <local:LedPreview x:Name="PreviewView" MaxHeight="420" MinHeight="260" Height="420"/>
                        <TextBlock Grid.Row="1" Text="Live preview · click paints an LED · right-click clears it"
                                   Opacity="0.45" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </Grid>

                    <!-- Lian Li fan editor: pick a fan, click a part on the model -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Top"
                                Visibility="{Binding ShowLianEditor, Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding LianFanNames}" SelectedIndex="{Binding LianFan}"
                                 Background="Transparent" BorderThickness="0" HorizontalAlignment="Center"
                                 ItemContainerStyle="{StaticResource Pill}" IsTextSearchEnabled="False"
                                 Margin="0,0,0,12">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <controls:LianLiFanView x:Name="LianFanView" Width="400" Height="380"
                                                HorizontalAlignment="Center"/>
                        <ItemsControl ItemsSource="{Binding LianParts}" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Tag="{Binding Tag}" Padding="12,4" Margin="3,0"
                                            Click="LianPart_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding LianGroupNames}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                      Visibility="{Binding HasLianGroups, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Padding="12,4" Margin="3,0" Click="LianGroup_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding LianSelectionLabel}" FontWeight="SemiBold" FontSize="14"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <TextBlock Text="Works both ways: click a part then pick a mode, or pick a mode then click the part to put it there. Each part runs its own effect at the same time."
                                   Opacity="0.45" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
</UserControl>
