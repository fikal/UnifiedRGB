<UserControl x:Class="UnifiedRgb.App.Views.LeftNavPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UnifiedRgb.App"
             xmlns:controls="clr-namespace:UnifiedRgb.App.Controls">
    <!-- DEVICES (scrolls) + SYSTEM (pinned at the bottom) navigation -->
            <DockPanel>
                <DockPanel.Resources>
                    <DataTemplate x:Key="LeftItemTemplate">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </DockPanel.Resources>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Setup" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Rescan" HorizontalAlignment="Right" Padding="10,5"
                            Command="{Binding RescanCommand}"/>
                </Grid>
                <!-- SYSTEM: pinned at the bottom, always reachable -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="#FF2A2E38" Margin="2,8,2,8"/>
                    <TextBlock Text="SYSTEM" FontSize="11" FontWeight="SemiBold"
                               Foreground="#FF9AA3B2" Opacity="0.8" Margin="2,0,0,6"/>
                    <ListBox x:Name="SystemNav" ItemsSource="{Binding SystemItems}" SelectedItem="{Binding SelectedLeftItem}"
                             Background="Transparent" BorderThickness="0" Foreground="#FFE6E6E6"
                             IsTextSearchEnabled="False" ItemContainerStyle="{StaticResource RowList}"
                             ItemTemplate="{StaticResource LeftItemTemplate}"
                             PreviewMouseLeftButtonUp="LeftNav_Click"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="DEVICES" FontSize="11" FontWeight="SemiBold"
                           Foreground="#FF9AA3B2" Opacity="0.8" Margin="2,0,0,6"/>
                <Grid>
                    <ListBox x:Name="DeviceNav" ItemsSource="{Binding DeviceItems}" SelectedItem="{Binding SelectedLeftItem}"
                             Background="Transparent" BorderThickness="0" Foreground="#FFE6E6E6"
                             IsTextSearchEnabled="False" ItemContainerStyle="{StaticResource RowList}"
                             ItemTemplate="{StaticResource LeftItemTemplate}"
                             PreviewMouseLeftButtonUp="LeftNav_Click"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    <!-- Nothing detected: give a first-time user somewhere to go
                         instead of an empty panel that reads as a broken app. -->
                    <Border Visibility="{Binding NoDevicesFound, Converter={StaticResource BoolToVis}}"
                            VerticalAlignment="Top" Margin="2,2,2,0" Padding="14"
                            Background="#FF1B1F29" BorderBrush="#FF2A2E38" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="No supported devices found" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Opacity="0.72" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Open Settings and turn on &quot;Use OpenRGB for extra devices&quot; to reach over a thousand more, then press Rescan."/>
                            <TextBlock Opacity="0.72" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Still empty? Use Report a problem in Settings to open a device request with your hardware details."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
</UserControl>
