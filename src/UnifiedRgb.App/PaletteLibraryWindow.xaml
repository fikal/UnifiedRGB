<Window x:Class="UnifiedRgb.App.PaletteLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palette Library" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="660" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        MouseLeftButtonDown="Drag_Down">
    <Border Background="#FF1B1D24" CornerRadius="12" Padding="22"
            BorderBrush="#FF2A2E38" BorderThickness="1">
        <!-- Grid, not a StackPanel: when MaxHeight bites, the CARD AREA gives up
             height (and scrolls) while the save/import/Done rows stay visible -
             a StackPanel just clipped the bottom off. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="Palette Library" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Click a palette to apply it to the current effect" Opacity="0.55" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="8,3" Click="Close_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <WrapPanel x:Name="Cards"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#FF14161C" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="SAVE CURRENT" FontSize="11" FontWeight="SemiBold" Foreground="#FF9AA3B2" Opacity="0.8"/>
                    <TextBlock Text="Store the colors on the current effect as a reusable palette." Opacity="0.5" FontSize="12" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SaveName" Width="260" Padding="6,4" VerticalContentAlignment="Center"/>
                        <Button Content="Save" Style="{StaticResource Accent}" Padding="16,6" Margin="10,0,0,0" Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#FF14161C" CornerRadius="8" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="IMPORT" FontSize="11" FontWeight="SemiBold" Foreground="#FF9AA3B2" Opacity="0.8"/>
                    <TextBlock Text="Paste a coolors.co URL or a list of hex codes." Opacity="0.5" FontSize="12" Margin="0,4,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="ImportText" Width="420" Padding="6,4" VerticalContentAlignment="Center"
                                 ToolTip="e.g. https://coolors.co/ffbe0b-fb5607-ff006e-8338ec-3a86ff"/>
                        <Button Content="Import" Padding="16,6" Margin="10,0,0,0" Click="Import_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status rides next to Done so it can never be pushed off-screen -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <TextBlock x:Name="ImportStatus" Opacity="0.65" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           TextTrimming="CharacterEllipsis" Margin="2,0,120,0"/>
                <Button Content="Done" Style="{StaticResource Accent}" HorizontalAlignment="Right" Padding="22,7" Click="Close_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
